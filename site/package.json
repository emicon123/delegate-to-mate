{
  "name": "delegatetomate-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --outDir dist",
    "build:root": "astro build --outDir dist",
    "build:test-static": "cross-env PUBLIC_BASE_PATH=/_test-static/ astro build --outDir dist-test-static",
    "build:delegate": "cross-env PUBLIC_BASE_PATH=/delegate/ astro build --outDir dist-delegate",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "astro": "^7.2.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "typescript": "^6.0.3"
  }
}
