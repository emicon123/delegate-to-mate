---
import { getCollection } from 'astro:content';

// Content source: docs/reference/mockup-build-snapshot.html — restored
// 2026-08-28, see docs/adr/003-mockup-copy-restoration.md and
// docs/architecture.md "Content restoration" (§8, FAQ). The live site had
// zero FAQ content, so this collection was intentionally empty until now;
// it's populated with the mockup's 4 real (non-placeholder) Q&A below. The
// `faqs.length > 0` guard is unchanged — it now just resolves true. The
// "FAQ" pill is removed per [EDIT #2].
//
// Flagged, not silently fixed: Q1's answer ("niewykorzystane-godziny.md")
// still refers to "Prawa Ręka" un-rebranded against the Delegate Wsparcie
// naming used in Services.astro — see docs/architecture.md's note on this;
// left as-is pending a user decision.
const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

{faqs.length > 0 && (
  <section class="section" id="faq" aria-labelledby="faq-heading" style="background:#fefbf1">
    <div class="container">
      <div style="max-width:560px;margin:0 0 28px">
        <h2 id="faq-heading" class="h-section" style="margin-top:0">Najczęściej zadawane pytania</h2>
      </div>

      <div class="faq-list" role="list" style="max-width:780px;margin:0">
        {faqs.map((faq, index) => (
          <details class="faq-item" role="listitem" open={index === 0}>
            <summary>
              <span>{faq.data.question}</span>
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-item__answer">{faq.data.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
