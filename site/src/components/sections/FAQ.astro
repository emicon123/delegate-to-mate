---
import { getCollection } from 'astro:content';

// Content source: docs/architecture.md — the live site has zero FAQ content
// (no accordion, no jet-tabs, no "?"-terminated questions in the DOM). This
// collection is CMS-managed and currently empty on purpose; the section
// renders nothing at all until real Q&A are authored via Decap or git at
// src/content/faq/*.md. Do not ship the mockup's placeholder Q&A.
const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

{faqs.length > 0 && (
  <section class="section" id="faq" aria-labelledby="faq-heading" style="background:#fefbf1">
    <div class="container">
      <div style="max-width:560px;margin:0 0 28px">
        <span class="pill" style="background:transparent;border:1px solid rgba(201,162,39,0.45);color:var(--amber-dark);font-size:10px;letter-spacing:0.13em">FAQ</span>
        <h2 id="faq-heading" class="h-section" style="margin-top:14px">Najczęściej zadawane pytania</h2>
      </div>

      <div class="faq-list" role="list" style="max-width:780px;margin:0">
        {faqs.map((faq, index) => (
          <details class="faq-item" role="listitem" open={index === 0}>
            <summary>
              <span>{faq.data.question}</span>
              <span class="faq-item__icon" aria-hidden="true">+</span>
            </summary>
            <div class="faq-item__answer">{faq.data.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
