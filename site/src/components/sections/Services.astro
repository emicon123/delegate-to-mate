---
import { getCollection } from 'astro:content';

// Content source: docs/architecture.md — 5 real services from /uslugi/,
// wired via getCollection() to src/content/services/*.md. No pricing exists
// on the live site — do not invent any. See architecture.md "Not found on
// either page" for the explicit no-pricing note.
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const icons: Record<string, string> = {
  settings: '▭',
  users: '⬢',
  'search-users': '◈',
  'shopping-cart': '◎',
  'trending-up': '▲',
};
---

<section class="section" id="uslugi" aria-labelledby="uslugi-heading" style="background:#fdf6ec;border-top:1px solid #f3e8d0;border-bottom:1px solid #f3e8d0">
  <div class="container">
    <div style="max-width:620px;margin:0 0 36px">
      <h2 id="uslugi-heading" class="h-section" style="margin-top:0">Usługi</h2>
      <p style="margin:0;color:#64748b;font-size:14.5px;line-height:1.65">
        Z&nbsp;dumą prezentuję Państwu moje projekty, które stworzyłem wykorzystując wszystkie moje umiejętności i&nbsp;profesjonalizm.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card__icon" aria-hidden="true">{icons[service.data.icon ?? ''] ?? '◈'}</div>
          <h3>{service.data.title}</h3>
          <p>{service.data.description}</p>
          {service.data.details && <div class="service-card__details">{service.data.details}</div>}
        </article>
      ))}
    </div>
  </div>
</section>
