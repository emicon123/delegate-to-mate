---
import { getCollection } from 'astro:content';

// Content source: docs/architecture.md — 6 real testimonials with full
// quotes (not the mockup's 3-card fragment version), wired via
// getCollection() to src/content/testimonials/*.md.
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section" id="opinie" aria-labelledby="testimonials-heading" style="background:#fdf8ec">
  <div class="container">
    <div style="max-width:560px;margin:0 0 28px">
      <span class="pill" style="background:transparent;border:1px solid rgba(201,162,39,0.45);color:var(--amber-dark);font-size:10px;letter-spacing:0.13em">OPINIE</span>
      <h2 id="testimonials-heading" class="h-section" style="margin-top:14px">Co mówią klienci</h2>
    </div>

    <div class="testimonials-grid">
      {testimonials.map((testimonial) => (
        <article class="testimonial-card">
          <div class="stars" aria-hidden="true">★★★★★</div>
          <blockquote>„{testimonial.data.quote}”</blockquote>
          <footer>
            <cite>
              <strong>{testimonial.data.author ?? testimonial.data.company}</strong>
              <span>{testimonial.data.company}</span>
            </cite>
          </footer>
        </article>
      ))}
    </div>
  </div>
</section>
