---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import platkowskiLogo from '../../assets/brands/platkowski.png';
import horizonLogo from '../../assets/brands/horizon.jpeg';
import bartomLogo from '../../assets/brands/bartom.png';
import artbudLogo from '../../assets/brands/artbud.png';
import gelatoLogo from '../../assets/brands/gelato.png';
import budspawLogo from '../../assets/brands/budspaw.png';

// Content source: docs/architecture.md "Real content mapping" — homepage Hero
// (H1 "INNOWACYJNE" / H2 "ROZWIĄZANIA DLA TWOJEGO BIZNESU" / H4 "Twoje wsparcie
// i efektywne zarządzanie zasobami" / CTA "NASZA FIRMA"). Two-heading live
// structure is folded into pill (kicker) + single <h1> for correct page outline.
const allServices = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const previewServices = allServices.slice(0, 2);

// "Zaufali nam" brand strip — same 6 companies as the Opinie section, per
// architecture.md (real logos carried over from wp-content/uploads).
const brands = [
  { name: 'Płatkowski.net', logo: platkowskiLogo },
  { name: 'Horizon', logo: horizonLogo },
  { name: 'Bartom', logo: bartomLogo },
  { name: 'Art-Bud', logo: artbudLogo },
  { name: 'Gelato Nobile', logo: gelatoLogo },
  { name: 'Budspaw', logo: budspawLogo },
];
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__grid">
      <div>
        <span class="pill" style="background:rgba(201,162,39,0.14);border:1px solid rgba(201,162,39,0.22);color:var(--amber);font-size:10px;letter-spacing:0.12em">INNOWACYJNE</span>
        <h1 id="hero-heading">
          ROZWIĄZANIA DLA&nbsp;TWOJEGO BIZNESU
        </h1>
        <p class="hero__sub">
          Twoje wsparcie i&nbsp;efektywne zarządzanie zasobami.
        </p>
        <div class="hero__ctas">
          <a href="#jak-to-dziala" class="btn btn--amber">NASZA FIRMA</a>
          <a href="#kontakt" class="btn btn--outline-light">SKONTAKTUJ SIĘ</a>
        </div>
      </div>

      <div class="hero__cards" aria-hidden="true">
        {previewServices.map((service) => (
          <div class="hero__mini">
            <div style="width:28px;height:28px;border-radius:8px;background:rgba(201,162,39,0.18);display:grid;place-items:center;color:var(--amber);font-size:13px;margin-bottom:10px">◈</div>
            <strong>{service.data.title}</strong>
            <p>{service.data.description}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="hero__brands">
      <span class="hero__brands-label">Zaufali nam</span>
      <div class="hero__brands-list">
        {brands.map((brand) => (
          <Image src={brand.logo} alt={brand.name} class="brand-logo" width={140} />
        ))}
      </div>
    </div>
  </div>
</section>
