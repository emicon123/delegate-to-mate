---
import type { Hero } from '../../lib/collections';

interface Props {
  hero: Hero;
}

const { hero } = Astro.props as Props;
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__grid">
      <div>
        <h1 id="hero-heading">{hero.heading}</h1>
        <p class="hero__sub">{hero.sub}</p>
        <div class="hero__ctas">
          <a href={hero.ctaPrimaryHref} class="btn btn--amber">{hero.ctaPrimaryLabel}</a>
          <a href={hero.ctaSecondaryHref} class="btn btn--outline-light">{hero.ctaSecondaryLabel}</a>
        </div>
      </div>

      <div class="hero__cards" aria-hidden="true">
        {hero.cards.map((card) => (
          <div class="hero__mini">
            <div class="hero__mini-icon">{card.icon}</div>
            <strong>{card.title}</strong>
            <p>{card.summary}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
