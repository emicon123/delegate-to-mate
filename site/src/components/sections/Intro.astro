---
import { getCollection } from 'astro:content';

const intro = (await getCollection('intro'))[0]?.data;
---

<section class="section section--cream" id="jak-to-dziala" aria-labelledby="intro-heading" style="background:#fdf8ec">
  <div class="container">
    <div class="intro__grid">
      <div>
        <h2 id="intro-heading" class="h-section" style="margin-top:0;font-size:clamp(30px,3.6vw,42px)">{intro.heading}</h2>
      </div>
      <div>
        <p style="margin:0;color:#475569;font-size:14.5px;line-height:1.75">
          {intro.paragraph}
        </p>
      </div>
    </div>
  </div>
</section>
