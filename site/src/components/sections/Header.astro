---
import { getCollection } from 'astro:content';

// FAQ nav link only appears once real Q&A exist (src/content/faq/*.md) —
// see docs/architecture.md: the live site has no FAQ content today.
const hasFaq = (await getCollection('faq')).length > 0;
---

<header class="site-header" role="banner">
  <div class="container site-header__inner">
    <a href="#top" class="wordmark" aria-label="Delegate To Mate — strona główna">
      delegate <span>to mate</span>
    </a>

    <nav class="nav" aria-label="Główna nawigacja">
      <a href="#uslugi">Usługi</a>
      <a href="#jak-to-dziala">Jak to działa</a>
      <a href="#opinie">Opinie</a>
      {hasFaq && <a href="#faq">FAQ</a>}
      <a href="#kontakt">Kontakt</a>
    </nav>

    <div style="display:flex;gap:10px;align-items:center">
      <a href="#kontakt" class="btn btn--dark nav-cta" style="padding:10px 18px;font-size:13px">SKONTAKTUJ SIĘ</a>
      <button
        class="mobile-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Otwórz menu"
        id="menu-toggle"
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <div class="container">
    <nav id="mobile-nav" class="mobile-panel" aria-hidden="true" aria-label="Menu mobilne">
      <a href="#uslugi">Usługi</a>
      <a href="#jak-to-dziala">Jak to działa</a>
      <a href="#opinie">Opinie</a>
      {hasFaq && <a href="#faq">FAQ</a>}
      <a href="#kontakt">Kontakt</a>
      <a href="#kontakt" class="btn btn--amber" style="margin-top:8px">SKONTAKTUJ SIĘ</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    panel?.setAttribute('aria-hidden', String(expanded));
  });
  panel?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      btn?.setAttribute('aria-expanded', 'false');
      panel?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
