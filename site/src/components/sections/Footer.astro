---
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const hasFaq = (await getCollection('faq')).length > 0;
const site = (await getCollection('site'))[0]?.data;
---

<footer class="site-footer" role="contentinfo" style="background:#081610;padding:36px 0 20px">
  <div class="container">
    <div class="footer-cols" style="display:grid;grid-template-columns:1.3fr 0.6fr 0.9fr;gap:32px;padding-bottom:24px">
      <div>
        <div style="font-family:var(--font-display);font-size:15px;color:white;letter-spacing:-0.02em">delegate <span style="color:var(--amber)">to mate</span></div>
      </div>
      <div>
        <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#7d89a8;font-weight:700;margin-bottom:12px">STRONA</div>
        <nav style="display:grid;gap:6px;font-size:13px">
          {site.nav.map((item) => (
            <a href={item.href} style="color:#a8b0cc">{item.label}</a>
          ))}
          {hasFaq && <a href="#faq" style="color:#a8b0cc">FAQ</a>}
        </nav>
      </div>
      <div>
        <div style="font-size:10px;letter-spacing:0.12em;text-transform:uppercase;color:#7d89a8;font-weight:700;margin-bottom:12px">KONTAKT</div>
        <div style="display:grid;gap:4px;font-size:12px;color:#a8b0cc;line-height:1.6">
          <a href={site.phoneHref} style="color:#a8b0cc">{site.phone}</a>
          <span>Facebook · Instagram {site.instagramHandle}</span>
        </div>
      </div>
    </div>
    <div style="border-top:1px solid rgba(255,255,255,0.07);padding-top:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;font-size:11px;color:#5a6588">
      <span>{site.footerCopyright}</span>
      <a href={`${base}polityka-prywatnosci/`} style="color:#5a6588">Polityka prywatności</a>
    </div>
  </div>
</footer>

<style>
  @media (max-width: 860px) {
    .footer-cols { grid-template-columns: 1fr !important; gap: 24px !important; }
  }
</style>
