---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import maciekPhoto from '../../assets/o-mnie/maciek-borys.png';

const omnie = (await getCollection('omnie'))[0]?.data;
---

<section class="section section--cream-2" id="o-mnie" aria-labelledby="omnie-heading">
  <div class="container">
    <div class="omnie__grid">
      <div class="omnie__photo-wrap">
        <div class="omnie__photo-frame" aria-hidden="true"></div>
        <div class="omnie__photo">
          <Image
            src={maciekPhoto}
            alt={omnie.photoAlt}
            width={427}
            height={640}
            densities={[1, 2]}
            quality="max"
            class="omnie__photo-img"
          />
        </div>
      </div>

      <div>
        <p class="omnie__kicker">{omnie.kicker}</p>
        <h2 id="omnie-heading" class="h-section" style="margin-top:0">{omnie.heading}</h2>

        {omnie.bio.map((paragraph) => (
          <p class="omnie__bio">{paragraph}</p>
        ))}

        <div class="omnie__signature">
          <p class="omnie__signature-name">{omnie.signatureName}</p>
          <p class="omnie__signature-role">{omnie.signatureRole}</p>
        </div>

        <a href={omnie.ctaHref} class="omnie__cta">{omnie.ctaLabel} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>
