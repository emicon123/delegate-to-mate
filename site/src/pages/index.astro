---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Services from '../components/sections/Services.astro';
import Benefits from '../components/sections/Benefits.astro';
import OMnie from '../components/sections/OMnie.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ from '../components/sections/FAQ.astro';
import CTA from '../components/sections/CTA.astro';
import Footer from '../components/sections/Footer.astro';

// Title/description updated 2026-08-28 alongside the mockup-copy
// restoration (docs/adr/003-mockup-copy-restoration.md) — the prior text
// was stale WP-era SEO copy that no longer matched the restored body
// content. No "final" head-tag text exists in any source, so this is
// assembled entirely from copy already restored elsewhere on the page
// (wordmark + Hero H1 for the title, the Hero subhead verbatim for the
// description) rather than invented — see docs/architecture.md's
// "SEO/meta" note for the full reasoning.
const title = 'delegate to mate — Prawa Ręka do prowadzenia firmy i do zakupu auta';
const description =
  'Dla właścicieli małych firm, którzy toną w sprawach bieżących i nie mają czasu na rozwój. Przejmuję operacyjny ciężar Twojej firmy i pilnuję, żebyś nie przepłacił za nowy samochód.';
const canonical = 'https://www.delegatetomate.pl/';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />
  <main id="main">
    <Hero />
    <Intro />
    <Services />
    <Benefits />
    <OMnie />
    <Testimonials />
    <FAQ />
    <CTA />
  </main>
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "DELEGATE TO MATE",
    url: canonical,
    telephone: "+48 796 017 986",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Marii Konopnickiej 22",
      postalCode: "43-200",
      addressLocality: "Pszczyna",
      addressCountry: "PL"
    },
    sameAs: ["https://www.facebook.com/delegate.to.mate", "https://www.instagram.com/delegate_to_mate"]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "DELEGATE TO MATE",
    url: canonical,
    inLanguage: "pl-PL"
  })} />
</BaseLayout>
